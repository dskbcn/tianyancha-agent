{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["**/dist/**", "**/.eve/**", "**/.output/**", "output/**"],
  "rules": {
    "typescript/no-explicit-any": "warn",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^(_|ignore)"
      }
    ],
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["eve", "eve/*", "ai", "@ai-sdk/*", "react", "react-dom"],
                "message": "packages/* must not depend on eve, the AI SDK or React: apps adapt the packages, never the other way round."
              }
            ]
          }
        ]
      }
    }
  ]
}
