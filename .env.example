# Copy to .env.dev for local development (git-ignored). `pnpm dev` loads it for the agent.

# --- Data source: 企业库查询 MCP server -------------------------------------
COMPANY_DB_MCP_URL=https://h5.dskb.cn/zh/company/mcp/
COMPANY_DB_API_KEY=
# At most this many MCP calls in flight; more trips the server's statement timeout (spike 0.3).
COMPANY_DB_CONCURRENCY=3
FIND_ROW_CAP=5000

# --- Results -----------------------------------------------------------------
# CSV results land in <OUTPUT_DIR>/<sessionId>/. Relative to apps/agent.
OUTPUT_DIR=../../output

# --- Model: Alibaba Cloud Bailian, OpenAI-compatible --------------------------
ALIYUN_BAILIAN_API_HOST=https://dashscope.aliyuncs.com
ALIYUN_BAILIAN_API_KEY=
# Default model; users pick per message from ALIYUN_BAILIAN_MODELS in the web UI.
ALIYUN_BAILIAN_MODEL=deepseek-v4.1-flash-1017
# Optional: comma-separated ids to offer (default: the six in apps/agent/agent/lib/models.ts).
# ALIYUN_BAILIAN_MODELS=deepseek-v4.1-flash-1017,deepseek-v4-pro-0813
# Bailian defaults to 8,192 output tokens without this; HTML artifacts need more.
ALIYUN_BAILIAN_MAX_OUTPUT_TOKENS=65536
# max_input_tokens from GET /compatible-mode/v1/models/<model>. Baked in at eve build.
ALIYUN_BAILIAN_CONTEXT_WINDOW=129024

# --- Route auth (production) --------------------------------------------------
# AGENT_USER=
# AGENT_PASSWORD=
